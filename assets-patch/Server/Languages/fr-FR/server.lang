customUI.triggerVolumeEffectEditor.field.DamageEntity.Mode.option.PERCENT_MAX.tooltip =  Use Amount as a percentage of max health.
customUI.triggerVolumeEffectEditor.field.DamageEntity.Mode.option.PERCENT_CURRENT.tooltip =  Use Amount as a percentage of current health.
