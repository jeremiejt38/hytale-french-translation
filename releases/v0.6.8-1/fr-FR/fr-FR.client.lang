builderTools.legend.SelectionTool.Page3.Title = Commandes de sélection
builderTools.legend.SelectionTool.Page3.BasicCommands = Commandes de base :\n\
- /set [Remplace la sélection par des blocs]\n\
- /clear [Retire tous les blocs de la sélection]\n\
- /walls [Ajoute des murs à la sélection]\n\
- /move [Déplace le contenu de la sélection dans la direction que vous regardez]\n\
- /undo et /redo [Annuler et rétablir X fois]\n\
- /copy [Copie la sélection dans le presse-papiers]\n\
- /cut [Coupe la sélection dans le presse-papiers]\n\
- /paste [Colle le presse-papiers à votre position]\n\
- /stack [Empile la sélection dans la direction que vous regardez X fois]\n\
- /replace [Remplace un matériau par un autre]\n\
- /hollow [Évide une forme en laissant le centre vide]\n\
- /flip [Miroir des blocs dans la direction que vous regardez]\n\
- /rotate [Pivote la sélection]\n\
- /expand [Étend la sélection dans la direction que vous regardez]\n\
- /contract [Réduit la sélection d'une distance]\n\
- /deselect [Efface la zone de sélection]
builderTools.legend.SelectionTool.Page3.SeeHelpMenu = Voyez le menu "/help" pour plus de commandes que vous pouvez exécuter sur votre sélection !

builderTools.legend.RulerTool.Page1.Title = Mesures de base
