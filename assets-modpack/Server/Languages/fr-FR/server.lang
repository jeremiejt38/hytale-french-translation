items.PortalKey_Windsurf_Valley.name = Fragment : Orbis - Vallée de Windrider
items.PortalKey_Windsurf_Valley.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Un Féran valorise la liberté par-dessus tout, et cette liberté n'est nulle part plus incarnée que dans les vents de Windrider Valley.</i>
items.PortalKey_Jungles.name = Fragment : Orbis - Refuge Tal'Kesi
items.PortalKey_Jungles.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Au plus profond des terres désolées laissées par une ancienne civilisation, un havre primordial prospère.</i>
items.PortalKey_Taiga.name = Fragment : Orbis - Dragonspire Weald
items.PortalKey_Taiga.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Il existe des forêts gelées dans lesquelles même un étranger n'ose pas mettre les pieds, peu importe les chuchotements.</i>
items.PortalKey_Hederas_Lair.name = Fragment : Orbis - Le Dread Wade
items.PortalKey_Hederas_Lair.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Peu de gens ont connu les terreurs qui se cachent dans les profondeurs les plus obscures d'Orbis.</i>
items.PortalKey_Henges.name = Fragment : Orbis - Silent Henges
items.PortalKey_Henges.description = <msg key="server.items.PortalKey.description"/>\n\n<i>Une mystérieuse tour de henges sur une terre gelée.</i>
items.Portal_Device.name = Ancienne passerelle
items.Portal_Device.description = Placez-le dans votre base pour abattre les barrières et voyager vers d'autres Fragments !<i>\nTravail en cours.\n\nBien que la malédiction garde l'Orbis de Gaia enfermé, il existe des moyens de percer le Vide qui le voile.</i>
